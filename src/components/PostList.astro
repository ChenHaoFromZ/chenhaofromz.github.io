---
import { urlOf, formatDate, type Post } from "../lib/posts";

interface Props {
  posts: Post[];
  lang: string;
}
const { posts, lang } = Astro.props;
---
<ul class="posts">
  {posts.map((post) => (
    <li>
      <a href={urlOf(post)}>{post.data.title}</a>
      <div class="meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
        {post.data.tags.length > 0 && <span> · {post.data.tags.join(" / ")}</span>}
      </div>
    </li>
  ))}
</ul>
<style>
  .posts { list-style: none; margin: 0; padding: 0; }
  .posts li { padding: .75rem 0; border-bottom: 1px solid var(--line); }
  .posts li:last-child { border-bottom: 0; }
  .posts a { text-decoration: none; font-size: 1.0625rem; }
  .posts a:hover { text-decoration: underline; }
</style>
