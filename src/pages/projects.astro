---
import Base from "../layouts/Base.astro";

// 替换成你自己的项目。建议每个项目写清：问题 → 做法 → 结果
const projects = [
  {
    name: "（项目名）",
    period: "2026",
    summary: "一句话说明它解决什么问题。",
    tags: ["AI", "Agent"],
    link: "",
  },
];
---
<Base title="项目 / Projects" lang="zh-CN" basePath="/projects/">
  <h1>项目 / Projects</h1>
  {projects.map((p) => (
    <article class="project">
      <h2>{p.link ? <a href={p.link}>{p.name}</a> : p.name}</h2>
      <p class="meta">{p.period}{p.tags.length > 0 && ` · ${p.tags.join(" / ")}`}</p>
      <p>{p.summary}</p>
    </article>
  ))}
</Base>
<style>
  .project { padding: 1rem 0; border-bottom: 1px solid var(--line); }
  .project:last-child { border-bottom: 0; }
  .meta { color: var(--muted); font-size: .875rem; }
</style>
